{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  // custom-elements.js imports the vanilla components. Leave it out of this
  // program so declaration emit cannot write .d.ts files beside them.
  "exclude": [
    "src/**/*.test.js",
    "src/**/*.stickersheet.jsx",
    "src/stickersheets/**",
    "src/custom-elements.js",
    "../../src",
    "../../dist"
  ]
}
