{
  "name": "@bootsmonday/corncob-design-language-react",
  "version": "0.1.0",
  "description": "React wrappers for Corncob EDL",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "sideEffects": [
    "./src/custom-elements.js"
  ],
  "files": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts",
    "dist-types/**/*.d.ts",
    "CHANGELOG.md",
    "!src/**/*.test.js",
    "!src/**/*.stickersheet.jsx",
    "!src/stickersheets/**",
    "!dist-types/**/*.test.d.ts",
    "!dist-types/**/*stickersheet*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ./scripts/build-types.mjs",
    "typecheck": "node ./scripts/build-types.mjs --check",
    "test": "jest --config ./jest.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bootsmonday/corncob-design-language"
  },
  "bugs": {
    "url": "https://github.com/bootsmonday/corncob-design-language/issues"
  },
  "homepage": "https://github.com/bootsmonday/corncob-design-language",
  "peerDependencies": {
    "@bootsmonday/corncob-design-language": "^0.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
